locals {
  prefix_under  = var.resource_prefix != "" ? "${var.resource_prefix}_" : ""
  data_location = "s3://${var.cur_exports_bucket}/${var.export_prefix}/${var.export_name}/data/"
}

# =============================================================
# Glue database — provider must target us-east-1
# =============================================================

resource "aws_glue_catalog_database" "finops_cur" {
  name        = "${local.prefix_under}finops_cur"
  description = "FinOps — données CUR 2.0"
  tags        = var.tags
}

# =============================================================
# CUR 2.0 external table
# Schema (columns) provided via var.columns, to copy from the
# create-table.sql generated by AWS after the first CUR delivery.
# Partition projection enabled at creation — no MSCK needed.
# =============================================================

# aws_glue_catalog_table does not support a tags argument
resource "aws_glue_catalog_table" "finops_cur" {
  name          = "${local.prefix_under}finops_cur"
  database_name = aws_glue_catalog_database.finops_cur.name
  table_type    = "EXTERNAL_TABLE"

  # Partition key as generated by AWS in create-table.sql
  partition_keys {
    name = "BILLING_PERIOD"
    type = "string"
  }

  storage_descriptor {
    location      = local.data_location
    input_format  = "org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat"
    output_format = "org.apache.hadoop.hive.ql.io.parquet.MapredParquetOutputFormat"

    ser_de_info {
      serialization_library = "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"
      parameters = {
        "serialization.format" = "1"
      }
    }

    # Empty columns until the AWS create-table.sql is received (see var.columns)
    dynamic "columns" {
      for_each = var.columns
      content {
        name = columns.value.name
        type = columns.value.type
      }
    }
  }

  parameters = {
    # Partition projection — avoids monthly MSCK REPAIR TABLE and ALTER TABLE ADD PARTITION
    "EXTERNAL"                                = "TRUE"
    "classification"                          = "parquet"
    "projection.enabled"                      = "true"
    "projection.billing_period.type"          = "date"
    "projection.billing_period.range"         = "${var.projection_start_date},NOW"
    "projection.billing_period.format"        = "yyyy-MM"
    "projection.billing_period.interval"      = "1"
    "projection.billing_period.interval.unit" = "MONTHS"
    # $${billing_period} → ${billing_period} in AWS, read by Athena as a projection variable
    "storage.location.template" = "s3://${var.cur_exports_bucket}/${var.export_prefix}/${var.export_name}/data/BILLING_PERIOD=$${billing_period}/"
  }
}
