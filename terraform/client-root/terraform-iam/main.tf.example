locals {
  common_tags = merge({ managed_by = "terraform" }, var.default_tags)
}

provider "aws" {
  region  = "us-east-1"
  profile = var.aws_profile
  default_tags { tags = local.common_tags }
}

module "iam_auditor" {
  source = "../../modules/iam-auditor"

  profile               = var.iam_auditor_profile
  enable_iam_policy     = var.iam_auditor_enable_iam_policy
  enable_tagging_policy = var.iam_auditor_enable_tagging_policy
  resource_prefix       = var.resource_prefix
  tags                  = local.common_tags
}
