locals {
  common_tags = merge({ managed_by = "terraform" }, var.default_tags)
}

provider "aws" {
  region  = var.infra_region
  profile = var.aws_profile
  default_tags { tags = local.common_tags }
}

module "audit_buckets_infra" {
  source = "../../../../finops-aws-toolkit/terraform/modules/audit-buckets"

  create_compute_optimizer_bucket = true
  create_analysis_group           = var.enable_s3_analysis
  use_global_namespace            = var.use_global_namespace
  resource_prefix                 = var.resource_prefix
  tags                            = local.common_tags
}

module "athena_workgroups_s3" {
  source = "../../../../finops-aws-toolkit/terraform/modules/athena-workgroups"

  create_s3_workgroup           = var.enable_s3_analysis
  athena_results_s3_bucket_name = module.audit_buckets_infra.athena_results_s3_bucket_name
  resource_prefix               = var.resource_prefix
  tags                          = local.common_tags
}

module "cloudwatch_agent" {
  source = "../../../../finops-aws-toolkit/terraform/modules/cloudwatch-agent"

  resource_prefix = var.resource_prefix
  tags            = local.common_tags
}

module "glue_s3_tables" {
  for_each = var.enable_s3_analysis ? toset(["enabled"]) : toset([])
  source   = "../../../../finops-aws-toolkit/terraform/modules/glue-s3-tables"

  s3_logging_bucket_name     = module.audit_buckets_infra.s3_logging_bucket_name
  s3_inventory_bucket_name   = module.audit_buckets_infra.s3_inventory_bucket_name
  source_bucket_names        = var.s3_source_bucket_names
  access_logs_year_start     = var.access_logs_year_start
  inventory_projection_start = var.inventory_projection_start
  resource_prefix            = var.resource_prefix
  tags                       = local.common_tags
}

module "s3_source_config" {
  for_each = var.enable_s3_analysis ? toset(["enabled"]) : toset([])
  source   = "../../../../finops-aws-toolkit/terraform/modules/s3-source-config"

  source_bucket_names   = var.s3_source_bucket_names
  logging_bucket_name   = module.audit_buckets_infra.s3_logging_bucket_name
  inventory_bucket_name = module.audit_buckets_infra.s3_inventory_bucket_name
  resource_prefix       = var.resource_prefix
  tags                  = local.common_tags
}
